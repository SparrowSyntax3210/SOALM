# Copy to ../.env (next to docker-compose.yml) and edit.
# oracle-setup.sh creates this file automatically on first run.

# Public hostname for HTTPS. With no domain of your own, use the free
# sslip.io name for your VM's public IP, e.g. 140-238-1-2.sslip.io
SOALM_DOMAIN=140-238-1-2.sslip.io

# Origins allowed to call the API from a browser. "*" allows any.
# Set this to your website once you know its URL, e.g.
# SOALM_CORS_ORIGINS=https://yoursite.onrender.com
SOALM_CORS_ORIGINS=*
