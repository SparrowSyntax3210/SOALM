data/era5/checkpoints_v2_final/
data/era5/features/
data/era5/features_v2_final/
data/era5/logs/
data/era5/logs_v2_final/
data/era5/prepared/
data/era5/raw/

# We DO need data/era5/models_v2_final/ — it is kept (not ignored).

